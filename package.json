{
  "name": "@nestjs/sequelize",
  "version": "12.0.1",
  "description": "Sequelize for NestJS: connections and models through dependency injection, transactions and multiple databases, for SQL databases.",
  "keywords": [
    "nestjs",
    "nest",
    "sequelize",
    "orm",
    "sql",
    "postgres",
    "mysql",
    "database"
  ],
  "author": "Kamil Mysliwiec",
  "license": "MIT",
  "url": "https://github.com/nestjs/sequelize#readme",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "oxlint lib/",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test:e2e": "vitest run",
    "test:e2e:dev": "vitest",
    "prerelease": "npm run build",
    "release": "release-it",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-angular": "21.2.4",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/testing": "12.4.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "mysql": "2.18.1",
    "oxlint": "1.92.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "reflect-metadata": "0.2.2",
    "release-it": "21.1.2",
    "rxjs": "7.8.2",
    "sequelize": "6.37.8",
    "sequelize-typescript": "2.1.6",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.2.0",
    "sequelize": "^6.3.5",
    "sequelize-typescript": "^2.0.0"
  },
  "lint-staged": {
    "**/*.{ts,json}": []
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs/sequelize"
  }
}
